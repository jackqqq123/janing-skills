{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DSH Skill Evaluation Results",
  "type": "object",
  "required": ["skill", "generatedAt", "limitations", "cases"],
  "properties": {
    "skill": {"type": "string"},
    "generatedAt": {"type": "string"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "required": ["id", "baseline", "withSkill", "assertions", "review"],
        "properties": {
          "id": {"type": "string"},
          "baseline": {"type": "object"},
          "withSkill": {"type": "object"},
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["status", "message"],
              "properties": {
                "status": {"enum": ["pass", "fail", "partial"]},
                "message": {"type": "string"}
              },
              "additionalProperties": true
            }
          },
          "review": {
            "type": "object",
            "required": ["verdict", "rationale"],
            "properties": {
              "verdict": {"enum": ["pass", "fail", "partial"]},
              "rationale": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
